# Application identity and runtime behavior
APP_NAME="Company Employee Management System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo

# Production: use APP_ENV=production, APP_DEBUG=false, and an https:// APP_URL.
# Production accepts direct trusted HTTPS only; forwarded protocol headers are not trusted.

# MySQL database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=company_employee_management
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Production must provide every DB_* value explicitly and must not inherit local credentials.

# Integration tests require a separate, explicitly designated test database.
# APP_ENV=test
# DB_TEST_HOST=127.0.0.1
# DB_TEST_PORT=3306
# DB_TEST_DATABASE=company_employee_management_test
# DB_TEST_USERNAME=change-me
# DB_TEST_PASSWORD=change-me
# DB_TEST_CHARSET=utf8mb4
